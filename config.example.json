{
  "sources": [
    {
      "id": "viwoods",
      "device": "Viwoods AiPaper",
      "path": "~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Viwoods",
      "fileTypes": ["pdf"]
    }
  ],
  "viwoodsCloud": {
    "id": "viwoods-cloud",
    "device": "Viwoods AiPaper",
    "apps": ["paper", "meeting", "memo"],
    "daily": true,
    "dailyMonths": 12
  },
  "google": {
    "clientId": "YOUR-CLIENT-ID.apps.googleusercontent.com",
    "clientSecret": "YOUR-CLIENT-SECRET"
  },
  "microsoft": {
    "clientId": "YOUR-APPLICATION-ID",
    "tenant": "common"
  },
  "ai": {
    "model": "claude-opus-5-5",
    "effort": "medium",
    "monthlyBudgetUSD": 5,
    "serverFallback": true
  },
  "destinations": [
    {
      "kind": "obsidian",
      "id": "obsidian",
      "vaultPath": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault",
      "folder": "Ink",
      "copyOriginal": true,
      "tags": ["ink"]
    },
    {
      "kind": "appleNotes",
      "id": "apple-notes",
      "folder": "Ink",
      "account": "iCloud"
    },
    {
      "kind": "appleCalendar",
      "id": "apple-calendar",
      "calendar": "Viwoods",
      "pageTitle": "Daily plan"
    },
    {
      "kind": "reviewStack",
      "id": "review",
      "port": 7788,
      "dailyLimit": 25,
      "resurfaceDays": [3, 14, 60]
    },
    {
      "kind": "googleCalendar",
      "id": "google-calendar",
      "calendar": "Viwoods",
      "pageTitle": "Daily plan"
    },
    {
      "kind": "googleDocs",
      "id": "google-docs",
      "folder": "Ink"
    },
    {
      "kind": "outlookCalendar",
      "id": "outlook-calendar",
      "calendar": "Viwoods",
      "pageTitle": "Daily plan"
    },
    {
      "kind": "oneNote",
      "id": "onenote",
      "notebook": "Ink"
    },
    {
      "kind": "appleReminders",
      "id": "apple-reminders",
      "list": "Ink · {device}"
    },
    {
      "kind": "notion",
      "id": "notion",
      "parentPageId": "YOUR-NOTION-PAGE-ID",
      "includeImages": true
    }
  ],
  "onDelete": {
    "obsidian": "archive",
    "apple-notes": "keep",
    "review": "delete"
  },
  "sendTargets": [
    {
      "kind": "viwoodsCloud",
      "id": "viwoods",
      "app": "learning"
    },
    {
      "kind": "folder",
      "id": "drive",
      "path": "~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Viwoods/Import"
    },
    {
      "kind": "kindle",
      "id": "kindle",
      "address": "you_123@kindle.com"
    }
  ],
  "recognition": {
    "languages": ["en-US"],
    "usesLanguageCorrection": true,
    "renderScale": 2,
    "maxPixelDimension": 3000
  },
  "rescanIntervalSeconds": 300,
  "settleSeconds": 5
}
