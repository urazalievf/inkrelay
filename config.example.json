{
  "sources": [
    {
      "id": "viwoods",
      "device": "Viwoods AiPaper",
      "path": "~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Viwoods",
      "fileTypes": ["pdf"]
    }
  ],
  "viwoodsCloud": {
    "id": "viwoods-cloud",
    "device": "Viwoods AiPaper",
    "apps": ["paper", "meeting", "memo"],
    "daily": true,
    "dailyMonths": 12
  },
  "destinations": [
    {
      "kind": "obsidian",
      "id": "obsidian",
      "vaultPath": "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault",
      "folder": "Ink",
      "copyOriginal": true,
      "tags": ["ink"]
    },
    {
      "kind": "appleNotes",
      "id": "apple-notes",
      "folder": "Ink",
      "account": "iCloud"
    },
    {
      "kind": "appleCalendar",
      "id": "apple-calendar",
      "calendar": "Viwoods",
      "pageTitle": "Daily plan"
    }
  ],
  "recognition": {
    "languages": ["en-US"],
    "usesLanguageCorrection": true,
    "renderScale": 2,
    "maxPixelDimension": 3000
  },
  "rescanIntervalSeconds": 300
}
